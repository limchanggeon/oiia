# backend/.env 로 복사해 사용 (.env는 git 추적 대상 아님)

# ── LLM (경로 비교 설명문 생성 전용 — VER3 §4) ──────
# rule      : LLM 미사용 (정형 문구). 키·네트워크 불필요
# anthropic : 상용 API (Claude). ANTHROPIC_API_KEY 필요
# ollama    : 로컬 LLM
LLM_PROVIDER=rule
LLM_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── 도구 모드 ─────────────────────────────────────
# live : TAGO 실조회 (운행정보·요금). 실패 시 해당 수단 제외 (FR-5 예외)
# mock : 목업 (골든패스 — 키 없이 시연 가능, 카드에 "시뮬레이션" 표시)
TOOL_MODE=mock

# TOOL_MODE=live에서 TAGO 실패 시 시뮬레이션으로 전환할지 (기본 false).
# true여도 출처를 속이지 않는다 — 카드에 "시뮬레이션"으로 표시된다 (§2).
SCHEDULE_FALLBACK_MOCK=false

# ── 운행정보·요금 (VER3 §1: 실제 외부 API) ──────────
# 공공데이터포털(data.go.kr)에서 아래 3개 오픈API 각각 '활용신청' 후
# 일반 인증키(Decoding)를 넣는다:
#   국토교통부(TAGO)_열차정보 / _고속버스정보 / _시외버스정보
TAGO_API_KEY=
ODSAY_API_KEY=

# ── 열차 좌석 조회 전용 계정 (VER3 §2) ──────────────
# 예약 함수는 호출하지 않는다. 조회에만 사용하며 로그·클라이언트에 노출 금지.
KORAIL_ID=
KORAIL_PW=
SRT_ID=
SRT_PW=

# ── 데모 이메일 알림 (FR-10) ───────────────────────
# 사용자 이메일 입력 없음 — 서버에 미리 등록된 이 주소로만 전송한다.
DEMO_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── 기타 ─────────────────────────────────────────
BAROTA_DB=barota.db
REQUIRE_APPROVAL=false
CORS_ORIGINS=*
