# ── LLM (판단 엔진) ──────────────────────────────
# rule      : 규칙 기반 (기본값 — 키·네트워크 불필요, 골든패스)
# anthropic : 상용 API (Claude) — ANTHROPIC_API_KEY 필요
# ollama    : 로컬 LLM (Ollama, guided JSON, temp=0)
LLM_PROVIDER=rule
# anthropic이면 claude-opus-4-8, ollama면 qwen3:4b 등
LLM_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── 도구 어댑터 3-mode ───────────────────────────
# live  : 실데이터 조회 (k-skill CLI 등) → 실패 시 cache → mock 3단 폴백
# cache : 캐시 우선 (60초 hold)
# mock  : 모의 데이터 100% (골든패스 — 시연이 절대 죽지 않음)
TOOL_MODE=mock
KSKILL_BIN=k-skill

# ── 저장소 ───────────────────────────────────────
BAROTA_DB=barota.db

# ── 승인 게이트 ───────────────────────────────────
# true면 side_effect 액션(예매·결제)에 X-Approved-By 헤더 필수
REQUIRE_APPROVAL=false

# ── 서버 ─────────────────────────────────────────
PORT=8000
CORS_ORIGINS=*

# ── 외부 API 키 자리 (k-skill live 모드용) ─────────
ODSAY_API_KEY=
